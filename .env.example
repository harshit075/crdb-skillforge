# CockroachDB Connection Configuration
COCKROACH_HOST=localhost
COCKROACH_PORT=26257
COCKROACH_USER=root
COCKROACH_PASSWORD=
COCKROACH_DATABASE=defaultdb
COCKROACH_SSLMODE=disable
COCKROACH_CLUSTER_NAME=crdb-local

# AWS Configuration (for AWS Bedrock, Lambda & S3 integration)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_DIAGNOSTICS_BUCKET=crdb-skillforge-telemetry

# CrDB SkillForge Configuration
SKILLFORGE_LOG_LEVEL=INFO
SKILLFORGE_MUTATION_CONFIRMATION=true
